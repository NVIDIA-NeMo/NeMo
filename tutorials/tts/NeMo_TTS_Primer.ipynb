   },
   "source": [
    "**Tokenization**"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "Dznknw-e6vhV",
    "pycharm": {
     "name": "#%% md\n"
    }
   },
   "source": [
